     <string name=\"about1\">Versatility</string>\r\n      <string name=\"about2\">High Standards</string>\r\n      <string name=\"about3\">We adopt a customer-centric approach in all our dealings!</string>\r\n      <string name=\"about4\">Our Services</string>\r\n      <string name=\"about5\">We provide in-house, multipronged services to our customers making us your one-stop destination for all your end-to-end B2B garment sourcing and supply solutions.</string>\r\n      <string name=\"about6\">Consultancy</string>\r\n      <string name=\"about7\">Discover a world of opportunities</string>\r\n      <string name=\"about8\">Financial Support</string>\r\n      <string name=\"about9\">Don’t let money problems hinder your business ventures</string>\r\n      <string name=\"about10\">SSS Technology</string>\r\n      <string name=\"about11\">Revolutionize the way you do your business</string>\r\n      <string name=\"about12\">Hospitality</string>\r\n      <string name=\"about13\">Business meets comfort</string>\r\n\r\n      <string name=\"que_1\">1.App k andr apna financial year kaise change krte hai?</string>\r\n      <string name=\"ans_1\">apne APP ko open kriye front page per upar right hand side corner per CALENDAR bna hua hai uspar click kriye or apna financial year select kar ke submit kr dijiye.</string>\r\n      <string name=\"que_2\">2.online payment krne k liye bank details kaise dekhe ?</string>\r\n      <string name=\"ans_2\">APP ke front page per right hand side niche ki taraf MORE ka option diya hua hai usi per click kre or dekhiye vahan per BANK DETAILS ka box bna hua hai usi per click kre apko apki bank detail dekhegi or easily aap payment kr skte hai.</string>\r\n      <string name=\"que_3\">3.mai apne stock ka tracking and delivery kaise check kru ?</string>\r\n      <string name=\"ans_3\">SORRY ; aap apne stock ka TRACKING and DELIVERY is APP ke through nhi check kar sakte hai uske liye apko SSS OFFICE mai call krna pdega.</string>\r\n      <string name=\"que_4\">4.app ko ek contact no se use krk dusare contact no se bhi use kr skte h kya?</string>\r\n      <string name=\"ans_4\">NO ; SSS APP ko ek hi CONTACT NO se USE kiya jaa sakta hai.</string>\r\n      <string name=\"que_5\">5.ek contact no se multiple phone m app use kr skte hai kya ?</string>\r\n      <string name=\"ans_5\">YES ;  SSS APP ko ek CONTACT NO se MULTIPLE PHONE mai APP USE kr sakte hai.</string>\r\n      <string name=\"que_6\">6.ledger report k ander mai CLEAR or UNCLEAR entry kaise check kru ?</string>\r\n      <string name=\"ans_6\">Front page per ek LEDGER ka option arha hai us per click kriye apka ledger open ho jayega or usi ledger mai aap sbse uper right hand side corner wale icon par click kriye fir usme select kr dijiye CLEAR ENTRY or UNCLEAR ENTRY fir niche option diya hua hai APPLY us per click ker dijiye apki report open ho jayegi.</string>\r\n      <string name=\"que_7\">7.sss sale bill kaise dekha jata hai ?</string>\r\n      <string name=\"ans_7\">\r\nFront page per ek SALE REPORT ka option arha hai us per click kriye apka sale report open hojaega usme particular koi ek SALE BILL NO dekhiye or usk SALE BILL NO KE LINk per click kr dijiye apka SALE BILL OPEN ho jayega.\r\n</string>\r\n      <string name=\"que_8\">8.supplier ka purchase bill kaise dekh skte hai?</string>\r\n      <string name=\"ans_8\">Front page per  SALE REPORT ka option arha hai us per click kriye apki sale report open ho jane k baad usme particular koi ek SALE BILL NO ka column dekhiye us column ke ander down arrow per click kriye click karte hi report open hogi jisme apko PURCHASE NO dikhega fir uske PURCHASE NO KE LINK per click ker dijiye apko apke SUPPLIER ka PURCHASE BILL dikh jayega.</string>\r\n      <string name=\"que_9\">9.Sale report ko BRAND WISE, TRANSPORT WISE kaise dekh skte hai ?</string>\r\n      <string name=\"ans_9\">Front page per SALE REPORT ke option ko click kriye apka sale report open ho jayega uske uper right hand side corner per filer par click kriye fir usme select kr dijiye BRAND NAME or TRANSPORT fir niche diye  APPLY us per click ker dijiye apki report open ho jayegi.</string>\r\n\r\n      <string name=\"permission_rationale\">Location permission is needed for core functionality</string>\r\n      <string name=\"permission_denied_explanation\">Permission was denied, but is needed for core\r\n        functionality.</string>\r\n      <string name=\"settings\">Settings</string>\r\n      <string name=\"ok\">OK</string>\r\n      <string name=\"request_location_updates\">Request location updates</string>\r\n      <string name=\"remove_location_updates\">Remove location updates</string>\r\n      <string name=\"location_updated\">Location Updated: %1$s</string>\r\n      <string name=\"alert\">Not Registered Try Login With</string>\r\n      <string name=\"alert1\">Alert</string>\r\n      <string name=\"text\">Select the given Accounts to login</string>\r\n      <string name=\"loginType\">Entered Number</string>\r\n      <string name=\"login_text2\">is not registered with us</string>\r\n      <string name=\"text_type\"> Not Registered</string>\r\n      <string name=\"text2_type\"> Try Login With</string>\r\n      <string name=\"dashboard_title\">Payment DashBoard</string>\r\n      <string name=\"dashboard_title2\">Avg Days (Bill Clear):-</string>\r\n      <string name=\"graph\">Graph</string>\r\n      <string name=\"list_til\">List Details</string>\r\n      <string name=\"text1\">Limit Particulars</string>\r\n      <string name=\"amount\">Amount</string>\r\n      <string name=\"your_limit\">Your Limit</string>\r\n      <string name=\"tem_limit\">Temporary Limit</string>\r\n      <string name=\"vvp_limit\">Security Limit</string>\r\n      <string name=\"bg\">B.G</string>\r\n      <string name=\"total_limit\">Total Limit</string>\r\n      <string name=\"balanceTillDate\">Balance Till Date </string>\r\n      <string name=\"interest\">Interest</string>\r\n      <string name=\"discount\">Discount</string>\r\n     