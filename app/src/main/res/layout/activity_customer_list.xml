<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eee"
    tools:context=".activitys.AccountActivity">



      <com.google.android.material.appbar.AppBarLayout
          android:id="@+id/toolbar1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:theme="@style/RoundedDialog">


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimaryDark"
                android:theme="@style/Widget.AppCompat.PopupMenu">
                </androidx.appcompat.widget.Toolbar>


      </com.google.android.material.appbar.AppBarLayout>
<RelativeLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
    android:id="@+id/rl"
    android:layout_below="@+id/toolbar1">
      <EditText
          android:id="@+id/search"
          android:layout_width="match_parent"
          android:layout_height="40dp"
          android:layout_marginLeft="2dp"
          android:layout_marginTop="2dp"
          android:layout_marginRight="2dp"
          android:layout_marginBottom="2dp"
          android:background="@drawable/otp_line"
          android:drawableLeft="@drawable/menu_search_white_24dp"
          android:drawablePadding="10dp"
          android:fontFamily="@font/roboto_light"
          android:gravity="center|left"
          android:imeOptions="actionDone"
          android:singleLine="true"
          android:hint="Search"
          android:padding="9dp"
          android:textColor="#90000000"
          android:textColorHint="#90000000"
          android:visibility="visible" />
      <TextView
          android:id="@+id/noOfRecord"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentEnd="true"
          android:layout_marginEnd="10dp"
          android:text="0 records"
          android:layout_centerInParent="true"
          />
</RelativeLayout>

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recyclerview"
          android:layout_below="@id/rl"
          android:layout_width="match_parent"
          app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
          android:orientation="vertical"
          android:layout_height="match_parent">
      </androidx.recyclerview.widget.RecyclerView>

<!--      <include layout="@layout/floating_button_layout"-->
<!--          android:id="@+id/supportChat">-->
<!--      </include>-->

      <include
          android:layout_centerInParent="true"
          layout="@layout/progress_loader"
          android:layout_height="wrap_content"
          android:layout_width="wrap_content"
          android:id="@+id/include_progress"/>




</RelativeLayout>