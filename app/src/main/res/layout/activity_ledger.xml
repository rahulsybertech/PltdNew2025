<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/all_bg"
    tools:context=".activitys.LedgerActivity">

      <include
          android:id="@+id/tool"
          layout="@layout/ledger_toolbar" />

      <LinearLayout
          android:id="@+id/ll"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/current_bel_le"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="10dp"
          android:background="@color/jjj"
          android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:text="Particulars"
                android:textColor="@color/black"
                android:textSize="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:layout_weight="1.4"
                android:background="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:text="Debit"
                android:textColor="@color/black"
                android:textSize="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:layout_weight="1.4"
                android:background="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:text="Credit"
                android:textColor="@color/black"
                android:textSize="18dp" />


      </LinearLayout>

      <LinearLayout
          android:id="@+id/current_bel_le"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/tool"
          android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6sp"
                android:layout_marginBottom="10dp">

                  <TextView
                      android:id="@+id/current_bel"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentStart="true"
                      android:layout_centerInParent="true"
                      android:fontFamily="@font/roboto_regular"
                      android:text="Opening Balance"
                      android:textColor="@color/black"
                      android:textSize="15dp"
                      android:textStyle="bold" />

                  <TextView
                      android:id="@+id/currentBal_Leg"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_centerInParent="true"
                      android:layout_marginLeft="20dp"
                      android:layout_toStartOf="@id/download_PDF"
                      android:layout_toEndOf="@+id/current_bel"
                      android:layout_toRightOf="@id/current_bel"
                      android:fontFamily="@font/roboto_regular"
                      android:textColor="@color/black"
                      android:textSize="15dp" />

                  <ImageView
                      android:id="@+id/download_PDF"
                      android:layout_width="30dp"
                      android:layout_height="30dp"
                      android:layout_alignParentRight="true"
                      android:layout_marginRight="20dp"
                      android:padding="4dp"
                      android:src="@drawable/ic_download" />

            </RelativeLayout>


      </LinearLayout>

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/Leger_reportRecy"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/ll"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="10dp"
          android:layout_marginBottom="20dp"
          android:nestedScrollingEnabled="false"
          android:orientation="vertical"
          app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager">

      </androidx.recyclerview.widget.RecyclerView>

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_alignParentBottom="true"
          android:layout_marginLeft="20dp"
          android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/closingBal"
                android:fontFamily="@font/roboto_regular"
                android:text="Closing Balance  "
                android:textColor="@color/black"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/closingBal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/black"
                android:textSize="15dp" />
      </RelativeLayout>

      <include
          android:id="@+id/include_progress"
          layout="@layout/progress_loader"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true" />

      <include
          android:id="@+id/supportChat"
          layout="@layout/floating_button_layout">

      </include>


</RelativeLayout>