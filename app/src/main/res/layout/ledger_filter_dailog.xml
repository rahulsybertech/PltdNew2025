<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text="Filter"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageView
            android:layout_alignParentRight="true"
            android:id="@+id/cancle_i"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:padding="5dp"
            android:src="@drawable/ic_cross2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/filter"
            android:background="@drawable/line"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.9"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ledgerFilter_Date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Date"
                    android:textSize="18dp" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@+id/ledgerFilter_Date"
                    android:background="@color/colorGrey2" />

                <TextView
                    android:id="@+id/adjustmentFilter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@id/line1"
                    android:gravity="start|center"
                    android:paddingLeft="6sp"
                    android:paddingEnd="27dp"
                    android:text="Adjustment"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/count_aduj"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_below="@id/line1"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/button_background"
                    android:gravity="center"
                    android:text="0" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@id/adjustmentFilter"
                    android:background="@color/colorGrey2" />


                <TextView

                    android:id="@+id/entryFilter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@id/line2"
                    android:gravity="start|center"
                    android:paddingLeft="6sp"
                    android:paddingEnd="27dp"
                    android:text="Entry"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/count_entry"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_below="@id/line2"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/button_background"
                    android:gravity="center"
                    android:text="0" />

                <View
                    android:id="@+id/line3"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@+id/entryFilter"
                    android:background="@color/colorGrey2" />

                <TextView
                    android:id="@+id/accountFilter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@+id/line3"
                    android:layout_marginTop="-1dp"
                    android:gravity="start|center"
                    android:paddingLeft="6sp"
                    android:paddingEnd="27dp"
                    android:text="Account"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/count_account"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_below="@id/line3"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/button_background"
                    android:gravity="center"
                    android:text="0" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@+id/accountFilter"
                    android:background="@color/colorGrey2" />

            </RelativeLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@color/colorPrimary" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/ll_price_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/min_max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="From date"
                            android:textSize="18dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="To date"
                            android:textSize="18dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/min_max"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/ledger_FromDate"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            android:background="@color/light_pink"
                            android:gravity="center|start"
                            android:hint="DD/MM/YYYY"
                            android:paddingLeft="10dp" />


                        <TextView
                            android:id="@+id/ledger_ToDate"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            android:background="@color/light_pink"
                            android:gravity="start|center"

                            android:hint="DD/MM/YYYY"
                            android:paddingLeft="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ledger_Recy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/ll_bottom"
                    android:layout_marginBottom="38dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/no_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_centerInParent="true"
                    android:text="No Filter Available for given date range"
                    android:textColor="@color/black"
                     />
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/progress"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    />
                <LinearLayout
                    android:id="@+id/ll_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/clear_all"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="20dp"
                        android:layout_weight="1"
                        android:background="@drawable/red_button"
                        android:gravity="center"
                        android:text="Reset"
                        android:textColor="@color/white"
                        android:textSize="18dp" />


                    <TextView
                        android:id="@+id/apply"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="20dp"
                        android:layout_weight="1"
                        android:background="@drawable/green_bg"
                        android:gravity="center"
                        android:text="Apply"
                        android:textColor="@color/white"
                        android:textSize="18dp" />
                </LinearLayout>


            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>