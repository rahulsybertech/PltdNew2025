<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.GST_NumberActivity">

    <!--    <RelativeLayout-->
    <!--        android:id="@+id/rl_login"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="match_parent"-->
    <!--        android:visibility="visible">-->

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:src="@drawable/ssslogopng" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/img">

        <RelativeLayout
            android:id="@+id/ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/white_bg"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="25dp"
                android:src="@drawable/ic_baseline_keyboard_backspace" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:padding="6dp"
                android:text="Please enter following details"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/text"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="Owner Name"
                android:textColor="@color/black"
                android:visibility="visible" />

            <TextView
                android:id="@+id/star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/text"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/text_name"
                android:fontFamily="@font/roboto_regular"
                android:text="*"
                android:textColor="@color/red"
                android:textSize="15dp"
                android:visibility="visible" />

            <EditText
                android:textSize="12sp"
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_name"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="30dp"
                android:background="@drawable/line"
                android:inputType="textCapCharacters"
                android:maxLength="50"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <TextView
                android:textColor="@color/red"
                android:visibility="gone"
                android:id="@+id/userName_size"
                android:textSize="14sp"
                android:layout_marginLeft="30dp"
                android:layout_below="@id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/text_firm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/userName_size"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="Firm Name"
                android:textColor="@color/black"
                android:visibility="visible" />

            <TextView
                android:id="@+id/star2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/userName_size"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/text_firm"
                android:fontFamily="@font/roboto_regular"
                android:text="*"
                android:textColor="@color/red"
                android:textSize="15dp"
                android:visibility="visible" />

            <EditText
                android:textSize="12sp"
                android:id="@+id/firmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_firm"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="30dp"
                android:background="@drawable/line"
                android:inputType="textCapCharacters"
                android:maxLength="50"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <TextView
                android:textColor="@color/red"
                android:visibility="gone"
                android:id="@+id/firmName_size"
                android:textSize="14sp"
                android:layout_marginLeft="30dp"
                android:layout_below="@id/firmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/text_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/firmName_size"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="Station"
                android:textColor="@color/black"
                android:visibility="visible" />

            <TextView
                android:id="@+id/star3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/firmName_size"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/text_station"
                android:fontFamily="@font/roboto_regular"
                android:text="*"
                android:textColor="@color/red"
                android:textSize="15dp"
                android:visibility="visible" />

            <EditText
                android:textSize="12sp"
                android:id="@+id/station_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_station"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="30dp"
                android:background="@drawable/line"
                android:inputType="textCapCharacters"
                android:maxLength="50"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <TextView
                android:textColor="@color/red"
                android:visibility="gone"
                android:id="@+id/station_add_size"
                android:textSize="14sp"
                android:layout_marginLeft="30dp"
                android:layout_below="@id/station_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/text_gstPan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/station_add_size"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="Enter Company's GST or PAN Detail"
                android:textColor="@color/black"
                android:visibility="gone" />

            <RadioGroup
                android:layout_below="@+id/text_gstPan"
                android:id="@+id/radioGroup_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/gstNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/red"
                    android:checked="true"
                    android:text="GST No." />

                <RadioButton
                    android:id="@+id/panNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/red"
                    android:text="PAN No." />

            </RadioGroup>

            <EditText
                android:id="@+id/gstAndPan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/radioGroup_id"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="30dp"
                android:background="@drawable/line"
                android:drawablePadding="20dp"
                android:maxLength="15"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/gstAndPan"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="Have a referral code?"
                android:textColor="@color/black"
                android:visibility="visible" />

            <TextView
                android:textSize="12dp"
                android:id="@+id/optional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/gstAndPan"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="30dp"
                android:layout_toRightOf="@id/text_ref"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:text="(Optional)"
                android:textColor="@color/red"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/code_ref"
                android:layout_below="@+id/text_ref"
                android:gravity="center"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:id="@+id/have_referal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/line"
                    android:inputType="textNoSuggestions"
                    android:maxLength="7"
                    android:paddingLeft="10dp"
                    android:paddingTop="10dp"
                    android:fontFamily="@font/roboto_regular"
                    android:paddingBottom="10dp" />

                <TextView
                    android:layout_margin="2dp"
                    android:id="@+id/refCode_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:background="@drawable/green_bg"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textSize="13dp"
                    android:text="Check Code"
                    android:textAllCaps="true"
                    android:textColor="@color/white" />



            </LinearLayout>

            <TextView
                android:id="@+id/ref_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/code_ref"
                android:layout_marginLeft="30dp"
                android:fontFamily="@font/roboto_regular"
                android:padding="6dp"
                android:textColor="@color/colorPrimary"
                android:visibility="visible" />

            <TextView
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_below="@+id/ref_name"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="100dp"
                android:layout_marginBottom="60dp"
                android:layout_weight="1"
                android:background="@drawable/red_button"
                android:gravity="center"
                android:text="SUBMIT"
                android:textAllCaps="true"
                android:textColor="@color/white" />

        </RelativeLayout>


    </ScrollView>

    <!--</RelativeLayout>-->

</RelativeLayout>