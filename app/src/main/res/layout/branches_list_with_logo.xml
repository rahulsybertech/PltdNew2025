<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_marginEnd="5dp"
    android:layout_marginStart="5dp"
    android:layout_marginTop="5dp"
    android:id="@+id/ll_top"
    android:background="@drawable/bg_light_gray"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:layout_weight="2"
        >
    <ImageView
        android:largeHeap="true"
        android:hardwareAccelerated="false"
        android:id="@+id/branchImg"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:padding="6dp"
        android:layout_gravity="center"
        android:scaleType="fitXY"
        tools:src="@drawable/sss_logo" />
    <TextView
        android:gravity="center"
        android:layout_below="@id/branchImg"
        android:id="@+id/branchname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:textColor="@color/black"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:fontFamily="@font/roboto_medium"
        tools:text="name"/>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:layout_marginEnd="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="1dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        android:layout_marginStart="2dp"
        android:id="@+id/bran_logo_recycler"
        android:layout_weight="1"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tint="@color/gray"
            android:layout_gravity="center|end"
            android:src="@drawable/ic_baseline_arrow_forward_"/>

    </LinearLayout>


    <FrameLayout
        android:id="@+id/ll_frame"
        android:layout_width="match_parent"
        android:layout_height="100dp" />
</RelativeLayout>

