<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible"
    android:id="@+id/llSummary"
    android:layout_marginTop="15dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

      <RelativeLayout
          android:visibility="gone"
          android:id="@+id/view_background"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/red">
            <ImageView
                android:id="@+id/delete_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_launcher_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/delete_icon"
                android:text="delete"
                android:textColor="#fff"
                android:textSize="13dp" />

      </RelativeLayout>
      <LinearLayout
          android:id="@+id/view_foreground"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_bottom_sheet_rounded"
          android:orientation="vertical"
          >

            <TableLayout
                android:id="@+id/t1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:background="@drawable/otp_line"
                >

                  <TableRow
                      android:id="@+id/table_row"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">


                        <!--                    <LinearLayout-->
                        <!--                        android:layout_marginLeft="4dp"-->
                        <!--                        android:layout_marginRight="4dp"-->
                        <!--                        android:background="@drawable/otp_line"-->
                        <!--                        android:layout_below="@id/t1"-->
                        <!--                        android:id="@+id/linet"-->
                        <!--                        android:layout_width="match_parent"-->
                        <!--                        android:layout_height="wrap_content"-->
                        <!--                        android:layout_marginTop="10dp"-->
                        <!--                        android:gravity="center"-->
                        <!--                        android:orientation="horizontal">-->

                        <TextView
                            android:id="@+id/item"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/roboto_light"
                            android:freezesText="true"
                            android:gravity="center|start"
                            android:hint="@string/item"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:paddingStart="10dp"
                            android:textColor="@color/black"
                            android:textSize="13dp"
                            android:visibility="visible">

                        </TextView>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="60dp"
                            android:background="@color/grey">

                        </View>


                        <Spinner
                            android:id="@+id/type"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.8"
                            android:layout_gravity="center"
                            android:gravity="end"
                            android:paddingEnd="0dp"
                            android:spinnerMode="dropdown"
                            android:hint="@string/type"
                            android:orientation="vertical"
                            android:textSize="9dp">

                        </Spinner>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/grey">

                        </View>

                        <EditText
                            android:id="@+id/qty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6"
                            android:background="@null"
                            android:imeOptions="actionNext"
                            android:layout_gravity="center"
                            android:fontFamily="@font/roboto_light"
                            android:gravity="center"
                            android:maxLength="4"
                            android:freezesText="true"
                            android:digits="0123456789"
                            android:hint="@string/qty"
                            android:inputType="number"
                            android:textSize="15dp">

                        </EditText>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/grey">

                        </View>


                        <EditText
                            android:id="@+id/amount"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6"
                            android:background="@null"
                            android:imeOptions="actionDone"
                            android:layout_gravity="center"
                            android:fontFamily="@font/roboto_light"
                            android:gravity="center"
                            android:freezesText="true"
                            android:maxLength="7"
                            android:hint="@string/amount1"
                            android:inputType="numberDecimal"
                            android:textSize="15dp">

                        </EditText>

                  </TableRow>

            </TableLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:visibility="gone"
                android:id="@+id/recyclerItem"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp"/>
            <LinearLayout

                xmlns:android="http://schemas.android.com/apk/res/android"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:id="@+id/llItemQuantity"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                  <com.google.android.material.textfield.TextInputLayout
                      android:id="@+id/llEtItem"
                      style="@style/LoginTextInputLayoutStyle"
                      android:layout_weight="2"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:visibility="visible">

                        <EditText
                            android:id="@+id/etItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:gravity="top|start"
                            android:hint="@string/item_name"
                            android:imeOptions="actionDone"
                            android:maxWidth="70dp"
                            android:maxEms="3"
                            android:maxLength="150"
                            android:maxLines="3"
                            android:paddingLeft="10dp"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                  </com.google.android.material.textfield.TextInputLayout>

                 <!-- <RelativeLayout
                      android:id="@+id/llEtItem"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="2dp"
                      android:layout_weight="2"
                      android:layout_width="0dp"
                      android:background="@drawable/otp_line">

                        <TextView
                            android:id="@+id/etItem"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_alignParentStart="true"
                            android:layout_marginEnd="5dp"
                            android:layout_toStartOf="@id/clearITem"
                            android:fontFamily="@font/roboto_light"
                            android:freezesText="true"
                            android:gravity="center|start"
                            android:paddingStart="10dp"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:visibility="visible" />


                        <ImageView
                            android:id="@+id/clearITem"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="5dp"
                            android:onClick="handleClear"
                            android:padding="7dp"
                            android:src="@drawable/ic_cross2"
                            app:tint="@color/red" />
                  </RelativeLayout>-->

                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/LoginTextInputLayoutStyle"
                      android:layout_weight="1"
                      android:layout_marginStart="5dp"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:visibility="visible">

                        <EditText
                            android:id="@+id/etQuantity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:gravity="top|start"
                            android:hint="@string/qty"
                            android:enabled="true"
                            android:textColorHint="@color/white"
                            android:inputType="number"
                            android:imeOptions="actionDone"
                            android:maxWidth="70dp"
                            android:maxEms="3"
                            android:maxLength="150"
                            android:maxLines="3"
                            android:paddingLeft="10dp"
                            android:textSize="16dp" />

                  </com.google.android.material.textfield.TextInputLayout>


                  <androidx.appcompat.widget.AppCompatImageView
                      android:id="@+id/btnAction"
                      android:visibility="gone"
                      android:layout_width="30dp"
                      android:layout_weight="0.1"
                      android:layout_height="30dp"
                      android:layout_gravity="center"
                      android:contentDescription="Add/Delete"
                      android:src="@drawable/ic_plus"/>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:weightSum="2">

                  <Button
                      android:id="@+id/btnCancel"
                      android:layout_width="0dp"
                      android:layout_weight="1"
                      android:layout_height="wrap_content"
                      android:text="Cancel"
                      android:backgroundTint="@color/gray"
                      android:textColor="@android:color/white"
                      android:layout_marginEnd="8dp" />

                  <Button
                      android:id="@+id/btnSave"
                      android:layout_width="0dp"
                      android:layout_weight="1"
                      android:layout_height="wrap_content"
                      android:text="Save"
                      android:backgroundTint="@color/red"
                      android:textColor="@android:color/white" />

            </LinearLayout>


      </LinearLayout>
</LinearLayout>