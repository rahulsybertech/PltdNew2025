<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/msg_dialog"
    android:background="@color/transperent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="10sp"
        android:background="@drawable/bg_white"
        android:padding="10dp">

        <ImageView
            android:id="@+id/cross"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:visibility="invisible"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_criss_cross" />


        <TextView
            android:id="@+id/textShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cross"
            android:gravity="center"
            android:text="Activate your SSS account for Transaction."
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textShow"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/filter_button_two"
            android:paddingStart="20dp"
            android:paddingTop="10sp"
            android:paddingEnd="20sp"
            android:paddingBottom="10sp"
            android:text="Activate"
            android:textColor="@color/white" />
    </RelativeLayout>

    <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/Item_Img"
        android:layout_width="60dp"
        android:layout_height="55dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/sss_logo"
        android:clickable="true"
        android:elevation="5dp"
        android:scaleType="centerCrop" />

































