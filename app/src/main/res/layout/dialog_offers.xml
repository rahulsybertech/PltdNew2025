<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_margin="2dp"
    android:background="@color/transperent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/cross"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/close_button" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cross"
        android:layout_marginTop="10dp"
        android:background="@color/white">

        <RelativeLayout
            android:layout_margin="10dp"
            android:id="@+id/ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/viewImages"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@color/black"
                android:scaleType="fitXY" />

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:visibility="gone"
                tools:ignore="WebViewLayout" />


        </RelativeLayout>

        <TextView
            android:id="@+id/offersName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll"
            android:layout_marginLeft="6dp"
            android:fontFamily="@font/helvetica_bold"
            android:textColor="@color/color_20"
            android:textSize="16dp" />


        <TextView
            android:id="@+id/valid_tile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/offersName"
            android:layout_marginStart="6dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp"
            android:text="Valid Till-"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/couponExpiryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/offersName"
            android:layout_marginStart="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp"
            android:layout_toRightOf="@id/valid_tile"
            android:text=""
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/couponCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/offersName"
            android:layout_alignParentRight="true"
            android:layout_marginStart="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp"
            android:drawableRight="@drawable/ic_coupon"
            android:drawablePadding="6dp"
            android:text="dfjoisjfsj"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offerDescription"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/couponCode"
            android:layout_marginLeft="6dp"
            android:textColor="@color/black" />

    </RelativeLayout>

</RelativeLayout>