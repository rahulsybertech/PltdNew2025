<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.ChooseCategries">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <ImageView
            android:id="@+id/img"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:padding="20dp"
            android:src="@drawable/ssslogopng" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/login_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="230dp"
        android:layout_marginRight="30dp"
        android:background="@drawable/white_bg"
        android:gravity="center"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:checkedButton="@id/supplier"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/supplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onRadioButtonClicked"
                android:text="Supplier"
                android:textSize="16dp" />

            <RelativeLayout
                android:id="@+id/supVisility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/otp_line"
                android:visibility="visible">


                <TextView
                    android:id="@+id/suplierClick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:drawableRight="@drawable/ic_down"
                    android:hint="fetching names.. "
                    android:padding="6dp" />


            </RelativeLayout>

            <RadioButton
                android:id="@+id/custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onRadioButtonClicked"
                android:text="Customer"
                android:textSize="16dp" />

            <RelativeLayout
                android:id="@+id/cusVisility"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@drawable/otp_line"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customClick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:drawableRight="@drawable/ic_down"
                    android:hint="fetching names.. "
                    android:padding="6dp" />
            </RelativeLayout>


            <RadioButton
                android:id="@+id/employee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onRadioButtonClicked"
                android:text="Others"
                android:textSize="16dp" />

            <RelativeLayout
                android:id="@+id/empVisility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/otp_line"
                android:visibility="gone">

                <TextView
                    android:id="@+id/employeeClick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:drawableRight="@drawable/ic_down"
                    android:hint="fetching names.. "
                    android:padding="6dp" />
            </RelativeLayout>


        </RadioGroup>

        <TextView
            android:text="OK"
            android:padding="10dp"
            android:layout_marginBottom="30dp"
            android:id="@+id/nextPage"
            android:layout_marginTop="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/red_circle"
            android:layout_weight="0"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </LinearLayout>


</RelativeLayout>