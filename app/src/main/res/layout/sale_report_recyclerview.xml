<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/all_outline"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="1dp"
                        android:layout_weight="0"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center|start"
                        android:text="Bill No          :"
                        android:textColor="@color/black"
                        android:textSize="12dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/saleBillNo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_weight="0.7"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center|start"
                        android:paddingStart="5dp"
                        android:text="21-45-4544-4545-484"
                        android:textColor="@color/red"
                        android:textSize="12dp" />

                    <TextView
                        android:id="@+id/saleDate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center|end"
                        android:paddingStart="2dp"
                        android:text="31-10-2023"
                        android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="Bilty No.       :"
                        android:textColor="@color/black"
                        android:textSize="12dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/saleBiltyNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_regular"
                        android:paddingStart="5dp"
                        android:textColor="@color/red"
                        android:textSize="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_weight="0"
                        android:fontFamily="@font/roboto_regular"
                        android:text="LR Date        :"
                        android:textColor="@color/black"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:visibility="gone"

                        />

                    <TextView
                        android:id="@+id/saleLR_Date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_regular"
                        android:paddingStart="5dp"
                        android:gravity="center|end"
                        android:textSize="12dp" />

                </LinearLayout>
            </LinearLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">
                  <LinearLayout
                      android:layout_width="match_parent"
                      android:orientation="vertical"
                      android:layout_weight="1"
                      android:layout_height="wrap_content">
                      <LinearLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_weight="1"
                          android:orientation="horizontal">


                          <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="1dp"
                              android:layout_weight="0"
                              android:fontFamily="@font/roboto_regular"
                              android:text="Sub Party     :"
                              android:textColor="@color/black"
                              android:textSize="12dp"
                              android:textStyle="bold"

                              />

                          <TextView
                              android:id="@+id/saleSubParty"
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="2dp"
                              android:layout_weight="1"
                              android:fontFamily="@font/roboto_regular"
                              android:paddingStart="5dp"
                              android:textSize="12dp" />

                      </LinearLayout>
                      <LinearLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_weight="1"
                          android:orientation="horizontal">


                          <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="1dp"
                              android:layout_weight="0"
                              android:fontFamily="@font/roboto_regular"
                              android:text="Transport     :"
                              android:textColor="@color/black"
                              android:textSize="12dp"
                              android:textStyle="bold"

                              />

                          <TextView
                              android:id="@+id/saleTransport"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="2dp"
                              android:layout_weight="1"
                              android:fontFamily="@font/roboto_regular"
                              android:paddingStart="5dp"
                              android:textSize="12dp" />


                      </LinearLayout>
                  </LinearLayout>

                  <TextView
                      android:layout_width="160dp"
                      android:layout_height="wrap_content"
                      android:paddingStart="0dp"
                      android:layout_weight="2"
                      android:textSize="10dp"
                      android:id="@+id/videoLink"
                      android:gravity="center"
                      android:drawableTop="@drawable/youtube_icon"
                      android:text="Packing\nVideo"
                      android:textColor="@color/blue"
                      android:layout_marginTop="2dp"
                      android:fontFamily="@font/roboto_regular"
                      />
            </LinearLayout>


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_weight="0"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Net Amount :"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold"

                    />

                <TextView
                    android:id="@+id/netAmt_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_regular"
                    android:paddingStart="5dp"
                    android:text="abc"
                    android:textSize="12dp" />

                <ImageView
                    android:id="@+id/plusClick"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/ic_down" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/otp_line">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/otp_line"
                    android:fontFamily="@font/helvetica_regular"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="Purchase No"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/otp_line"
                    android:fontFamily="@font/helvetica_regular"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="Supplier"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:background="@drawable/otp_line"
                    android:fontFamily="@font/helvetica_regular"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="Pcs"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/otp_line"
                    android:fontFamily="@font/helvetica_regular"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="Amount"
                    android:textColor="@color/black"
                    android:textSize="12dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reclerItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"></androidx.recyclerview.widget.RecyclerView>

        </LinearLayout>




    </LinearLayout>

<!--    <ImageView-->
<!--        android:id="@+id/plusClick"-->
<!--        android:src="@drawable/ic_plus"-->
<!--        android:layout_marginRight="20dp"-->
<!--        android:layout_marginTop="100dp"-->
<!--        android:layout_alignParentRight="true"-->
<!--        android:layout_width="30dp"-->
<!--        android:layout_height="25dp"/>-->


</RelativeLayout>
