<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.ReferralCodeActivity">


    <RelativeLayout
        android:layout_width="match_parent"
        android:visibility="visible"
        android:id="@+id/rl_login"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/ssslogopng" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/ll"
            android:layout_margin="20dp"
            android:background="@drawable/white_bg"
            android:layout_below="@+id/img">

            <TextView
                android:layout_marginTop="10dp"
                android:textColor="@color/black"
                android:id="@+id/tv_dis"
                android:gravity="center"
                android:padding="5dp"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginLeft="20dp"
                android:text="Kindly enter your referral code here"
                android:layout_width="match_parent"
                android:layout_below="@+id/img"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/referralCode_number"
                android:inputType="number"
                android:paddingLeft="10dp"
                android:drawablePadding="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginTop="5dp"
                android:textAllCaps="true"
                android:layout_marginRight="30dp"
                android:layout_marginLeft="30dp"
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginBottom="60dp"
                android:id="@+id/login"
                android:layout_marginTop="30dp"
                android:layout_marginRight="100dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:text="SUBMIT"
                android:background="@drawable/red_button"
                android:layout_marginLeft="100dp"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
        </LinearLayout>

        <ImageView
            android:layout_margin="30dp"
            android:layout_below="@id/img"
            android:src="@drawable/ic_baseline_keyboard_backspace"
            android:layout_width="30dp"
            android:layout_height="30dp"/>

    </RelativeLayout>



</RelativeLayout>