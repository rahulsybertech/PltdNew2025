<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.BookingRequestActivity">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="50dp"
          android:background="@color/colorPrimary"
          tools:layout_editor_absoluteX="0dp"
          tools:layout_editor_absoluteY="0dp"
          tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/backBookingList"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/back8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Booking Request"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:textStyle="bold" />

      </RelativeLayout>



      <ScrollView
          android:id="@+id/scroll"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
            <LinearLayout
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                  <RelativeLayout
                      tools:layout_editor_absoluteX="16dp"
                      tools:layout_editor_absoluteY="78dp"
                      android:layout_marginTop="10dp"
                      android:layout_width="match_parent"
                      android:background="@drawable/otp_line"
                      android:layout_height="40dp"
                      tools:ignore="MissingConstraints">

                        <Spinner
                            android:id="@+id/spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:spinnerMode="dropdown"
                            tools:ignore="MissingConstraints"
                            tools:layout_editor_absoluteX="16dp"
                            tools:layout_editor_absoluteY="8dp" />
                  </RelativeLayout>
                  <LinearLayout
                      android:layout_marginTop="20dp"
                      android:id="@+id/llDispatchDate"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llCheckIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="Check in date"
                                  android:textColor="@color/black"/>
                              <LinearLayout
                                  android:layout_marginTop="10dp"
                                  android:layout_width="match_parent"
                                  android:layout_height="wrap_content"
                              >
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/set_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/calendar"
                                        />
                                    <TextView
                                        android:id="@+id/tvCheckInDate"
                                        android:layout_width="130dp"
                                        android:layout_height="40dp"
                                        android:layout_marginEnd="10dp"
                                        android:layout_weight="1"
                                        android:layout_marginStart="10dp"
                                        android:background="@drawable/otp_line"
                                        android:fontFamily="monospace"
                                        android:gravity="center"
                                        android:hint="Date From"
                                        android:imeOptions="actionNext"
                                        android:maxLines="1"
                                        android:padding="8dp"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />


                              </LinearLayout>

                        </LinearLayout>


                        <LinearLayout

                            android:orientation="vertical"
                            android:id="@+id/llCheckOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="Check out date"
                                  android:textColor="@color/black"/>

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_marginTop="10dp"
                                  android:layout_height="wrap_content"
                               >
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/set_date_to"
                                        android:layout_width="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/calendar"

                                        />
                                    <TextView
                                        android:id="@+id/tvCheckOutDate"
                                        android:layout_width="130dp"
                                        android:layout_height="40dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginEnd="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/otp_line"
                                        android:fontFamily="monospace"
                                        android:gravity="center"
                                        android:hint="Date To"
                                        android:imeOptions="actionNext"
                                        android:maxLines="1"
                                        android:padding="8dp"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />

                              </LinearLayout>

                        </LinearLayout>
                  </LinearLayout>
                  <LinearLayout
                      android:layout_marginTop="20dp"
                      android:layout_width="match_parent"
                      android:weightSum="2"
                      android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llCheckInTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="Check in time"
                                  android:textColor="@color/black"/>
                              <LinearLayout
                                  android:layout_marginTop="10dp"
                                  android:layout_width="match_parent"
                                  android:layout_height="wrap_content"
                                  android:layout_weight="1">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/stopwatch"/>
                                    <TextView
                                        android:id="@+id/tvCheckInTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="40dp"
                                        android:layout_marginEnd="10dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/otp_line"
                                        android:fontFamily="monospace"
                                        android:gravity="center"
                                        android:hint="12:00 AM"
                                        android:imeOptions="actionNext"
                                        android:maxLines="1"
                                        android:padding="8dp"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />
                              </LinearLayout>

                        </LinearLayout>


                        <LinearLayout

                            android:orientation="vertical"
                            android:id="@+id/llCheckOutTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="Check out time"
                                  android:textColor="@color/black"/>

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_marginTop="10dp"
                                  android:layout_height="wrap_content"
                                  android:weightSum="1">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/stopwatch"
                                        />
                                    <TextView
                                        android:id="@+id/tvCheckOutTime"
                                        android:layout_width="130dp"
                                        android:layout_height="40dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginEnd="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/otp_line"
                                        android:fontFamily="monospace"
                                        android:gravity="center"
                                        android:hint="10:00 PM"
                                        android:imeOptions="actionNext"
                                        android:maxLines="1"
                                        android:padding="8dp"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />

                              </LinearLayout>

                        </LinearLayout>
                  </LinearLayout>
                  <LinearLayout
                      android:orientation="vertical"
                      android:layout_marginTop="20dp"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:text="No. of person"
                            android:textColor="@color/black"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                              <androidx.appcompat.widget.AppCompatImageView
                                  android:src="@drawable/no_of_person"
                                  android:layout_width="wrap_content"
                                  android:layout_gravity="center"
                                  android:layout_height="wrap_content"/>
                              <RelativeLayout
                                  android:layout_marginStart="10dp"
                                  android:background="@drawable/otp_line"
                                  android:layout_width="match_parent"
                                  android:layout_height="40dp">
                                    <EditText
                                        android:id="@+id/editNoOfPerson"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="5dp"
                                        android:layout_weight="1"
                                        android:background="@null"
                                        android:fontFamily="monospace"
                                        android:imeOptions="actionNext"
                                        android:maxLines="1"
                                        android:maxLength="1"
                                        android:inputType="number"
                                        android:padding="8dp"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />
                                    <ImageView
                                        android:visibility="gone"
                                        android:id="@+id/clearNoPerson"
                                        android:layout_width="30dp"
                                        android:layout_height="match_parent"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerInParent="true"
                                        android:layout_marginEnd="5dp"
                                        android:onClick="handleClear"
                                        android:padding="7dp"
                                        android:src="@drawable/ic_cross2"
                                        app:tint="@color/red" />
                              </RelativeLayout>

                        </LinearLayout>

                  </LinearLayout>

                  <androidx.cardview.widget.CardView
                      android:layout_marginTop="50dp"
                      android:layout_gravity="center"
                      app:cardCornerRadius="10dp"
                      android:layout_width="150dp"
                      android:layout_height="45dp">
                        <RelativeLayout
                            android:id="@+id/save"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/green">

                              <TextView
                                  android:id="@+id/tvSave"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textColor="@color/white"
                                  android:layout_centerInParent="true"
                                  android:textSize="14dp"

                                  android:text="@string/save"/>

                        </RelativeLayout>
                  </androidx.cardview.widget.CardView>
                  <TextView

                      android:text="@string/no_purchase_no_stay"
                      android:textColor="@color/red"
                      android:textAlignment="center"
                      android:layout_marginTop="20dp"
                      android:textSize="15sp"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"/>

            </LinearLayout>
      </ScrollView>






</LinearLayout>