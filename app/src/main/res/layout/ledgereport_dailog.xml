<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filter"
        android:id="@+id/filter"
        android:gravity="center"
        android:padding="5dp"
        android:textColor="@color/black"
        android:textSize="18dp"/>
    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:id="@+id/cancle_i"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:src="@drawable/ic_cross2"/>
    <LinearLayout
        android:background="@drawable/line"
        android:layout_below="@+id/filter"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:orientation="vertical"
            android:layout_weight="1.9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/pendingFilter_Date"
                android:gravity="center"
                android:textSize="18dp"
                android:text="Date"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>

            <View
                android:layout_below="@+id/pendingFilter_Date"
                android:id="@+id/line1"
                android:background="@color/colorGrey2"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <TextView
                android:layout_below="@id/line1"
                android:gravity="center"
                android:textSize="18dp"
                android:text="Adjustment"
                android:id="@+id/adjustment_ledger"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>

            <View
                android:layout_below="@id/adjustment_ledger"
                android:id="@+id/line2"
                android:background="@color/colorGrey2"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <TextView
                android:layout_below="@id/line2"
                android:gravity="center"
                android:textSize="18dp"
                android:text="Entry Type"
                android:id="@+id/entry_type"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>

            <View
                android:id="@+id/line3"
                android:layout_below="@+id/entry_type"
                android:background="@color/colorGrey2"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <TextView
                android:layout_below="@+id/line3"
                android:padding="6dp"
                android:gravity="center"
                android:textSize="18dp"
                android:text="Account Type"
                android:id="@+id/account_type"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>

            <View
                android:layout_below="@+id/account_type"
                android:background="@color/colorGrey2"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

        </RelativeLayout>

        <View
            android:background="@color/colorPrimary"
            android:layout_weight="0"
            android:layout_width="2dp"
            android:layout_height="match_parent"/>

        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ll_price_range"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/min_max"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <TextView
                        android:textSize="18dp"
                        android:gravity="center"
                        android:text="From date"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>


                    <TextView
                        android:gravity="center"
                        android:text="To date"
                        android:textSize="18dp"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_below="@id/min_max"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <TextView
                        android:paddingLeft="10dp"
                        android:background="@color/light_pink"
                        android:layout_margin="6dp"
                        android:textSize="18dp"
                        android:hint="Rs"
                        android:inputType="number"
                        android:id="@+id/stockDate"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"/>


                    <TextView
                        android:background="@color/light_pink"
                        android:paddingLeft="10dp"
                        android:layout_margin="6dp"
                        android:hint="Rs"
                        android:id="@+id/stock_ToDate"
                        android:textSize="18dp"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pending_Recy"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/ll_bottom"
                android:layout_marginBottom="20dp"
                android:visibility="visible" />

            <LinearLayout
                android:layout_alignParentBottom="true"
                android:layout_marginTop="20dp"
                android:id="@+id/ll_bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <TextView
                    android:textColor="@color/white"
                    android:background="@color/gray"
                    android:layout_margin="20dp"
                    android:textSize="18dp"
                    android:gravity="center"
                    android:id="@+id/clear_all"
                    android:text="Clear all"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>


                <TextView
                    android:id="@+id/apply"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="20dp"
                    android:layout_weight="1"
                    android:background="@color/gray"
                    android:gravity="center"
                    android:text="Apply"
                    android:textColor="@color/white"
                    android:textSize="18dp" />
            </LinearLayout>

        </RelativeLayout>


    </LinearLayout>


</RelativeLayout>