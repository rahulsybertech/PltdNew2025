<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="0.5dp"
    android:padding="3dp"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_grey_corner">

        <RelativeLayout
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:paddingStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grey_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="12sp"
                android:id="@+id/billDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:padding="2dp"
                android:text="BillDate"
                android:textColor="@color/black" />

            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:visibility="gone"
                android:id="@+id/accountID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/billDate"
                android:gravity="start"
                android:padding="2dp"
                android:text="AccountID" />

            <TextView
                android:id="@+id/blDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/accountID"
                android:gravity="left"
                android:padding="2dp"
                android:singleLine="true"
                android:text="BLDescription"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:padding="2dp"
                android:layout_below="@id/blDescription"
                android:gravity="left"
                android:text="Balance"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/balance_ledger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/blDescription"
                android:layout_alignParentRight="true"
                android:layout_toRightOf="@id/balance"
                android:gravity="start"
                android:padding="2dp"
                android:text="Balance" />
        </RelativeLayout>

        <TextView
            android:padding="2dp"
            app:autoSizeTextType="none"
            android:textSize="12sp"
            android:background="@color/light_pink"
            android:id="@+id/ledger_debit"
            android:layout_weight="1.4"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            app:autoSizeTextType="none"
            android:textSize="12sp"
            android:id="@+id/ledger_credit"
            android:background="@drawable/bg_grey_corner"
            android:gravity="center"
            android:layout_weight="1.4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


    </LinearLayout>



