<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eee"
    xmlns:app="http://schemas.android.com/apk/res-auto">

      <LinearLayout
          android:layout_above="@+id/plusButton"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:background="@color/colorPrimary"
                android:layout_height="50dp">
                  <ImageView
                      android:id="@+id/backBookingList"
                      android:layout_width="30dp"
                      android:layout_height="30dp"
                      android:layout_marginStart="10dp"
                      android:layout_centerVertical="true"
                      android:src="@drawable/ic_back_arrow" />
                  <TextView
                      android:id="@+id/back8"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_centerInParent="true"
                      android:textSize="15dp"
                      android:textColor="@color/white"
                      android:text="Booking Details"
                      android:textStyle="bold" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rl"
                android:layout_below="@+id/toolbar1">
                  <EditText
                      android:id="@+id/search"
                      android:layout_width="match_parent"
                      android:layout_height="40dp"
                      android:layout_marginLeft="2dp"
                      android:layout_marginTop="2dp"
                      android:layout_marginRight="2dp"
                      android:layout_marginBottom="2dp"
                      android:background="@drawable/otp_line"
                      android:drawableLeft="@drawable/menu_search_white_24dp"
                      android:drawablePadding="10dp"
                      android:fontFamily="@font/roboto_light"
                      android:gravity="center|left"
                      android:imeOptions="actionDone"
                      android:singleLine="true"
                      android:hint="Search"
                      android:padding="9dp"
                      android:textColor="#90000000"
                      android:textColorHint="#90000000"
                      android:visibility="visible" />
                  <TextView
                      android:id="@+id/noOfRecord"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentEnd="true"
                      android:layout_marginEnd="10dp"
                      android:text="0 records"
                      android:layout_centerInParent="true"
                      />
            </RelativeLayout>
            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent">
                  <androidx.recyclerview.widget.RecyclerView
                      android:id="@+id/recyler"
                      android:orientation="vertical"
                      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                      android:layout_marginTop="2dp"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"/>
                  <include
                      android:layout_centerInParent="true"
                      layout="@layout/progress_loader"
                      android:layout_height="wrap_content"
                      android:layout_width="wrap_content"
                      android:id="@+id/include_progress"/>
            </RelativeLayout>



      </LinearLayout>



      <RelativeLayout
          android:id="@+id/plusButton"
          android:layout_alignParentBottom="true"
          android:layout_alignParentRight="true"
          android:layout_marginBottom="5dp"
          android:layout_width="150dp"
          android:layout_height="45dp">
            <LinearLayout
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:textColor="@color/blue"
                      android:layout_gravity="center_vertical"
                      android:layout_marginEnd="10dp"
                      android:textSize="13dp"
                      android:text="Add New Visit"
                      />
                  <RelativeLayout
                      android:layout_marginEnd="10dp"
                      android:background="@drawable/red_circle"
                      android:backgroundTint="@color/blue"
                      android:layout_width="40dp"
                      android:layout_height="40dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tint="@color/white"
                            android:src="@drawable/ic_plus"/>
                  </RelativeLayout>
            </LinearLayout>
      </RelativeLayout>




</RelativeLayout>