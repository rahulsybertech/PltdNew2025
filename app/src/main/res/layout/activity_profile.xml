<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/all_bg"
    tools:context=".activitys.ProfileActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/app_bar"
        android:theme="@style/RoundedDialog">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:theme="@style/Widget.AppCompat.PopupMenu">

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>



    <androidx.core.widget.NestedScrollView
        android:layout_below="@id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


<!--            <ImageView-->
<!--                android:layout_centerHorizontal="true"-->
<!--                android:id="@+id/edit_pro"-->
<!--                android:layout_marginBottom="3dp"-->
<!--                android:layout_marginTop="10dp"-->
<!--                android:background="@drawable/sss_logo"-->
<!--                android:layout_width="90dp"-->
<!--                android:layout_height="90dp">-->

<!--            </ImageView>-->

            <RelativeLayout
                android:layout_margin="10dp"
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/reg"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/colorPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/name" />

                        <TextView
                            android:id="@+id/profileName"
                            android:padding="6dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/text_bg"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>





                    <LinearLayout
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/colorPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/mobile_number" />

                        <TextView
                            android:id="@+id/profileMob_No"
                            android:padding="6dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/text_bg"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/colorPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/email" />

                        <TextView
                            android:id="@+id/profileEmail"
                            android:padding="6dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/text_bg"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>


                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/colorPrimary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/party_code" />

                            <TextView
                                android:id="@+id/profile_pirtyCode"
                                android:padding="6dp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/text_bg"
                                android:fontFamily="@font/roboto_regular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/colorPrimary"
                                android:fontFamily="@font/roboto_regular"
                                android:layout_marginLeft="20dp"
                                android:text="@string/fin_year"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/finYear"
                                android:text="2018"
                                android:padding="6dp"
                                android:layout_marginTop="2dp"

                                android:layout_marginLeft="20dp"
                                android:background="@drawable/text_bg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="0dp"
                            android:id="@+id/textPostage"
                            android:text="Postage Charge" />

                        <Switch
                            android:id="@+id/postege"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_gravity="end"
                            android:layout_marginTop="10dp"
                            android:checked="false"
                            android:textOff="No"
                            android:textOn="Yes" />
                    </RelativeLayout>

                </LinearLayout>



<!--                <TextView-->
<!--                    android:layout_alignParentBottom="true"-->
<!--                    android:layout_below="@id/reg"-->
<!--                    android:layout_marginBottom="60dp"-->
<!--                    android:layout_marginTop="30dp"-->
<!--                    android:layout_marginRight="100dp"-->
<!--                    android:textColor="@color/black"-->
<!--                    android:gravity="center"-->
<!--                    android:text="@string/submit"-->
<!--                    android:background="@drawable/shadow_button_layer_list"-->
<!--                    android:layout_marginLeft="100dp"-->
<!--                    android:layout_weight="1"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="40dp"/>-->



            </RelativeLayout>


        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/floating_button_layout"
        android:id="@+id/supportChat">
    </include>
    <include
        android:layout_centerInParent="true"
        layout="@layout/progress_loader"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/include_progress"/>




</RelativeLayout>