<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_margin="6dp"
    android:background="@color/white"
    android:layout_height="wrap_content">
      <LinearLayout
          android:layout_marginTop="10dp"
          android:layout_marginBottom="10dp"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/llfull"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                  <RelativeLayout
                      android:padding="2dp"
                      android:layout_marginStart="10dp"
                      android:layout_marginEnd="10dp"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">
                        <LinearLayout
                            android:visibility="visible"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:layout_marginEnd="60dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                              <TextView
                                  android:layout_width="wrap_content"
                                  android:fontFamily="@font/roboto_regular"
                                  android:layout_height="wrap_content"
                                  android:textColor="@color/black"
                                  android:textStyle="bold"
                                  android:textSize="12dp"
                                  android:text="Visit Id                  :"/>
                              <TextView
                                  android:id="@+id/visitId"
                                  android:layout_marginStart="5dp"
                                  android:textColor="@color/black"
                                  android:ellipsize="end"
                                  android:singleLine="true"
                                  android:layout_width="match_parent"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="NA"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/actionIcons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:gravity="end">

                              <ImageView
                                  android:id="@+id/edit"
                                  android:layout_width="24dp"
                                  android:layout_height="24dp"
                                  android:src="@drawable/edit"
                                  android:contentDescription="Edit"
                                  android:layout_marginStart="8dp"
                                  android:padding="4dp" />

                              <ImageView
                                  android:id="@+id/llCancel"
                                  android:layout_width="24dp"
                                  android:layout_height="24dp"
                                  android:src="@drawable/delete_new"
                                  android:contentDescription="Delete"
                                  android:layout_marginStart="8dp"
                                  android:padding="4dp" />
                        </LinearLayout>
                  </RelativeLayout>
                  <LinearLayout
                      android:padding="2dp"
                      android:layout_marginStart="10dp"
                      android:layout_marginEnd="10dp"
                      android:orientation="horizontal"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:textStyle="bold"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:text="Branch Name     :"/>
                        <TextView
                            android:id="@+id/branchName"
                            android:layout_marginStart="5dp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:text="NA"/>


                  </LinearLayout>
                  <LinearLayout
                      android:id="@+id/llCheckInDate"
                      android:padding="2dp"
                      android:layout_marginStart="10dp"
                      android:layout_marginEnd="10dp"
                      android:orientation="horizontal"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:text="Check In              :"/>
                        <TextView
                            android:id="@+id/checkInTimeAndDate"
                            android:layout_marginStart="5dp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:text="NA"/>


                  </LinearLayout>
                  <RelativeLayout
                      android:id="@+id/rlCheckOutDate"
                      android:layout_width="match_parent"
                      android:layout_height="match_parent">
                        <LinearLayout
                            android:padding="2dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                              <TextView
                                  android:textColor="@color/black"
                                  android:fontFamily="@font/roboto_regular"
                                  android:textStyle="bold"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="Check Out           :"/>
                              <TextView
                                  android:id="@+id/checkOutDateAndTime"
                                  android:layout_marginStart="5dp"
                                  android:textColor="@color/black"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="NA"/>

                        </LinearLayout>
                  </RelativeLayout>

                  <RelativeLayout
                      android:id="@+id/rlNoOfPerson"
                      android:layout_marginStart="10dp"
                      android:layout_marginEnd="10dp"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                              <TextView
                                  android:textColor="@color/black"
                                  android:layout_width="wrap_content"
                                  android:fontFamily="@font/roboto_regular"
                                  android:textStyle="bold"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="No Of Person      :"/>
                              <TextView
                                  android:id="@+id/noOfPerson"
                                  android:layout_marginStart="5dp"
                                  android:textColor="@color/black"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:textSize="12dp"
                                  android:text="NA"/>

                        </LinearLayout>

                  </RelativeLayout>


            </LinearLayout>


            <RelativeLayout
                android:layout_marginEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                  <RelativeLayout
                      android:layout_marginStart="10dp"
                      android:id="@+id/rlActualCheckInOut"
                      android:visibility="gone"
                      android:layout_centerVertical="true"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:visibility="visible"
                            android:id="@+id/cardCheckIn"
                            android:layout_marginEnd="10dp"
                            android:layout_width="wrap_content"
                            app:cardCornerRadius="10dp"
                            android:layout_height="wrap_content">
                              <RelativeLayout
                                  android:padding="5dp"
                                  android:background="@color/green"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content">
                                    <TextView
                                        android:id="@+id/tvStatus"
                                        android:layout_marginStart="5dp"
                                        android:layout_marginEnd="5dp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="12dp"
                                        android:text="Mark Check IN"/>
                              </RelativeLayout>

                        </androidx.cardview.widget.CardView>


                  </RelativeLayout>
                  <LinearLayout
                      android:id="@+id/llActualCheckoutDate"
                      android:layout_centerVertical="true"
                      android:orientation="horizontal"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12dp"
                            android:layout_marginStart="10dp"
                            android:textStyle="bold"
                            android:text="A.Chkout Date    :"/>
                        <TextView
                            android:id="@+id/tvActualCheckoutDate"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13dp"
                            android:text=" NA"/>
                  </LinearLayout>
               <!--   <LinearLayout
                      android:visibility="gone"
                      android:id="@+id/llSwitch"
                      android:layout_alignParentRight="true"
                      android:orientation="horizontal"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/toggleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STAY YES"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/red"
                            android:textSize="12sp"
                            />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/yesNoSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text=""
                            android:splitTrack="true"
                            android:thumb="@drawable/thumb_drawable"
                            android:track="@drawable/track_drawable"
                            android:padding="4dp" />
                  </LinearLayout>-->


            </RelativeLayout>



      </LinearLayout>


</RelativeLayout>