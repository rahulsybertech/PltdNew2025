<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

      <androidx.cardview.widget.CardView
          android:id="@+id/product_card"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp">

                  <LinearLayout
                      android:id="@+id/ll_sale"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_weight="0"
                            android:fontFamily="@font/roboto_regular"
                            android:text="SaleParty           :"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sale_party"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="15dp"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingStart="5dp"
                            android:textColor="@color/green"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/call_"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/out_line_no_outline"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center|start"
                            android:paddingStart="10dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="2dp"
                            android:text="Call"
                            android:textStyle="bold"
                            android:textColor="@color/blue"
                            android:textSize="10sp" />
                  </LinearLayout>


                  <LinearLayout
                      android:id="@+id/ll_sup"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="2dp"
                      android:visibility="gone"
                      android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dst_ret_mech"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_weight="0"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Supplier              :"
                            android:textColor="@color/black"
                            android:textSize="12dp"
                            android:textStyle="bold"

                            />

                        <TextView
                            android:id="@+id/suplier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="15dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center|start"
                            android:paddingStart="5dp"
                            android:textColor="@color/green"
                            android:textSize="12dp" />


                  </LinearLayout>
                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_weight="0"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Item                    :"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold"

                            />

                        <TextView
                            android:id="@+id/item_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingStart="5dp"
                            android:textColor="@color/black"
                            android:textSize="12dp" />
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_weight="0"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Type                    :"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold"

                            />

                        <TextView
                            android:id="@+id/pcs_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingStart="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_weight="0"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Sub Party           :"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold"

                            />

                        <TextView
                            android:id="@+id/subParty_penOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingStart="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="5dp"
                      android:background="@drawable/otp_line">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Order No."
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Order Date"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/amt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Amt"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Qty"
                            android:textColor="@color/black" />

                  </LinearLayout>

                  <LinearLayout
                      android:id="@+id/ll_2"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:background="@drawable/otp_line">

                        <TextView
                            android:id="@+id/order_no"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:textColor="@color/red" />

                        <TextView
                            android:id="@+id/order_date"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="200"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/amt_no"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="200"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/qty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1.4"
                            android:background="@drawable/otp_line"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="00"
                            android:textColor="@color/black" />
                  </LinearLayout>

                  <LinearLayout
                      android:id="@+id/ll_3"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="5dp"
                      android:orientation="horizontal">

<!--                        <TextView-->
<!--                            android:id="@+id/email_status"-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_weight="1"-->
<!--                            android:drawableStart="@drawable/ic_gmail"-->
<!--                            android:drawablePadding="5dp"-->
<!--                            android:fontFamily="@font/helvetica_regular"-->
<!--                            android:gravity="start|center"-->
<!--                            android:text="Resend"-->
<!--                            android:textColor="@color/black"-->
<!--                            android:visibility="visible" />-->

<!--                        <TextView-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_weight="1"-->
<!--                            android:drawableStart="@drawable/ic_baseline_power_settings_new_24"-->
<!--                            android:fontFamily="@font/helvetica_regular"-->
<!--                            android:gravity="center|start"-->
<!--                            android:text="Resend"-->
<!--                            android:textColor="@color/black"-->
<!--                            android:visibility="gone" />-->

                        <TextView
                            android:id="@+id/cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/baseline_cancel_24"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center|start"
                            android:text="Cancel Order"
                            android:background="@drawable/btnnn"
                            android:textColor="@color/red"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/confirm"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:background="@drawable/btnnn"
                            android:drawableStart="@drawable/baseline_check_circle_24"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center|start"
                            android:text="Confirm Order"
                            android:textColor="@color/green"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/view_img"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:layout_weight="1.2"
                            android:drawableStart="@drawable/ic_baseline_photo_library_24"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/helvetica_regular"
                            android:gravity="center|start"
                            android:background="@drawable/btnnn"
                            android:text="View Img"
                            android:textColor="@color/black"
                            android:visibility="visible" />
                  </LinearLayout>
            </LinearLayout>
      </androidx.cardview.widget.CardView>
</LinearLayout>
