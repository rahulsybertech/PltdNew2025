<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



        <LinearLayout
            android:layout_margin="6dp"
            android:background="@drawable/all_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">



                <LinearLayout

                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supplier name     :"
                        android:layout_weight="0"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/black"

                        />

                    <TextView
                        android:textColor="@color/green"
                        android:text="abc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:layout_weight="1"
                        android:textSize="12dp"
                        android:id="@+id/pendingSupplier_Name"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_regular"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_weight="2.1"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">




                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order No. :"
                        android:layout_weight="0"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/black"

                        />

                    <TextView
                        android:textColor="@color/green"
                        android:text="abc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:layout_weight="1"
                        android:textSize="12dp"
                        android:id="@+id/pendingOrder_no"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_regular"
                        />



                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="0"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Marketer Name   :"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold"

                    />

                <TextView
                    android:textColor="@color/black"
                    android:text="abc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:id="@+id/marketer_pending"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_regular"
                    />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">



                <LinearLayout

                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sub Party             :"
                        android:layout_weight="0"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/black"

                        />

                    <TextView
                        android:textColor="@color/green"
                        android:text="abc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:layout_weight="1"
                        android:textSize="12dp"
                        android:id="@+id/pendingSub_party"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_regular"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_weight="2.1"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">




                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date :"
                        android:layout_weight="0"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/black"

                        />

                    <TextView
                        android:text="20/08/2020"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:layout_weight="1"
                        android:textSize="12dp"
                        android:id="@+id/pending_date"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_regular"
                        />



                </LinearLayout>
            </LinearLayout>
