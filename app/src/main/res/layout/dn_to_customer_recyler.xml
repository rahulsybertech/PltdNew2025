<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_margin="6dp"
        android:background="@drawable/all_outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <LinearLayout
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invoice No   :"
                    android:layout_weight="0"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/black"

                    />

                <TextView
                    android:textColor="@color/red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:id="@+id/invoiceNo_dnCustomer"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_regular"
                    />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">




            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill Ref No.   : "
                android:layout_weight="0"
                android:textSize="12dp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginTop="1dp"
                android:textColor="@color/black"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:layout_weight="1"
                android:textSize="12dp"
                android:id="@+id/bill_refNo_dnCustomer"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                />



        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <LinearLayout

                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="0"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Date               :"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold"

                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:id="@+id/date_dnCustomer"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_regular"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">




                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invoice Date :"
                    android:layout_weight="0"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/black"

                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:id="@+id/invoice_datednCustomer"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_regular"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout

            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Supplier         :"
                android:layout_weight="0"
                android:textSize="12dp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginTop="1dp"
                android:textColor="@color/black"

                />

            <TextView
                android:id="@+id/supplier_dnCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:layout_weight="1"
                android:textSize="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                />
            <ImageView
                android:id="@+id/plusClick"
                android:src="@drawable/ic_down"
                android:layout_alignParentRight="true"
                android:layout_width="30dp"
                android:layout_height="25dp"/>
        </LinearLayout>

        <LinearLayout

            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Net Amount  :"
                android:layout_weight="0"
                android:textSize="12dp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginTop="1dp"
                android:textColor="@color/black"

                />

            <TextView
                android:id="@+id/netAmt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:layout_weight="1"
                android:textSize="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/otp_line">
            <!--            <TextView-->
            <!--                android:textSize="12dp"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_weight="1"-->
            <!--                android:text="Customer"-->
            <!--                android:padding="2dp"-->
            <!--                android:background="@drawable/otp_line"-->
            <!--                android:gravity="center"-->
            <!--                android:textColor="@color/black"-->
            <!--                android:fontFamily="@font/helvetica_regular"/>-->
            <TextView
                android:textSize="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Item"
                android:padding="2dp"
                android:background="@drawable/otp_line"
                android:gravity="center"
                android:textColor="@color/black"
                android:fontFamily="@font/helvetica_regular"/>

<!--            <TextView-->
<!--                android:textSize="12dp"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_weight="1"-->
<!--                android:gravity="center"-->
<!--                android:padding="2dp"-->
<!--                android:background="@drawable/otp_line"-->
<!--                android:text="qty"-->
<!--                android:textColor="@color/black"-->
<!--                android:fontFamily="@font/helvetica_regular"/>-->
            <TextView
                android:textSize="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Amount"
                android:padding="2dp"
                android:background="@drawable/otp_line"
                android:textColor="@color/black"
                android:fontFamily="@font/helvetica_regular"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:visibility="gone"
            android:id="@+id/dncustomer_itemRecyler"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>

</RelativeLayout>